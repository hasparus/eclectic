{
  "name": "@hasparus/oxlint-config",
  "version": "0.5.0",
  "description": "my shared oxlint config",
  "license": "MIT",
  "files": [
    "anti-slop",
    "oxlint.config.ts",
    "oxlint.config.js",
    "with-sorting.ts",
    "with-sorting.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./oxlint.config.ts",
      "default": "./oxlint.config.js"
    },
    "./with-sorting": {
      "types": "./with-sorting.ts",
      "default": "./with-sorting.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint -c with-sorting.ts --deny-warnings --ignore-pattern \"anti-slop/**\"",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@interfere/landmines": "0.1.0",
    "@oxlint/plugins": "1.94.0",
    "eslint-plugin-better-tailwindcss": "4.0.2",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-sonarjs": "4.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.7",
    "oxlint": "1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "oxlint": "^1.94.0",
    "tsrs": ">=0.25.0-ts7.1.0-beta"
  }
}
